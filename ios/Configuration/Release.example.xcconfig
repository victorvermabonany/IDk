// Copy to an untracked Release.xcconfig or inject these build settings in CI.
// Never put OPENAI_API_KEY, database credentials, or grocery-provider secrets in iOS build settings.
COVE_RUNTIME_MODE = PRODUCTION_LIVE
COVE_API_BASE_URL = https://api.example.com
COVE_PRIVACY_URL = https://example.com/privacy
COVE_TERMS_URL = https://example.com/terms
COVE_SUPPORT_URL = https://example.com/support
DEVELOPMENT_TEAM = YOUR_TEAM_ID
